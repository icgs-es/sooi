# Synthetic names only. Copy values from an approved secret/configuration store.
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=replace-with-a-unique-random-value-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=app.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.invalid
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true
DJANGO_USE_X_FORWARDED_HOST=true
DB_NAME=sooi
DB_USER=sooi
DB_PASSWORD=replace-from-secret-store
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=SOOI <no-reply@sooi.io>
STATIC_ROOT=/opt/sooi/var/static
MEDIA_ROOT=/opt/sooi/var/media
